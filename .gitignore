# 构建产物
/target
**/target
src-tauri/target/

# Node
node_modules/
dist/

# 打包产出（安装包体积大，不入库）
*.app
*.dmg
*.msi
*.exe
src-tauri/target/release/bundle/

# 本地数据
events.json
*.backup.json

# 系统
.DS_Store
Thumbs.db
*.log

# 编辑器
.idea/
.vscode/
*.swp

# Tauri 构建期自动生成的 ACL schema，不入库
src-tauri/gen/schemas/

# 撤销用户全局 .gitignore 对 *.md / LICENSE / *.png 的忽略（本项目需要这些文件）
!README.md
!LICENSE
!src-tauri/icon-source.png
!src-tauri/icons/**

