{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "如期而至",
  "version": "0.2.2",
  "identifier": "com.ruqierzhi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "如期而至",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Duely（如期而至）- 到期时间提醒助手",
    "longDescription": "如期而至帮你管理会员、保险、合同、证件、账单、订阅等一切会到期的事件，并在到期前按时弹出系统级通知提醒，关掉窗口也不漏接。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {}
}
